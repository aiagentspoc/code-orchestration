{
  "command-allowlist": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/hooks/auto_allow.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
